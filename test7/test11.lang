// Test if and if-else statements
program
{
    int x;

    x = 1;
    if (x == 1)
        print(10);
    endif;

    if (x == 0)
        print(20);
    endif;

    if (x == 1)
        print(30);
    else
        print(40);
    endif;

    if (x == 0)
        print(50);
    else
        print(60);
    endif;

    // Nested if
    if (x == 1)
        if (1 == 1)
            print(70);
        endif;
    endif;
}
