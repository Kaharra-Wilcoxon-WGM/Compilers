// Kaharra Wilcoxon
// Test operator precedence and associativity
// * / % should bind tighter than + -
// Left-to-right associativity within same level
program
{
    print(2 + 3 * 4);
    print(10 - 2 * 3);
    print(2 * 3 + 4 * 5);
    print(100 / 10 / 2);
    print(10 - 3 - 2);
    print(2 + 3 * 4 - 1);
    print(15 % 4 + 1);
}
